{"version": 2, "width": 90, "height": 24, "timestamp": 1754697600, "title": "Module 01 — inspect your machine", "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.4, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[0.9, "o", "uname -a\r\n"]
[1.0, "o", "Linux box 6.8.0-generic #1 SMP x86_64 GNU/Linux\r\n"]
[1.6, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[2.1, "o", "lscpu | head -6\r\n"]
[2.2, "o", "Architecture:            x86_64\r\n  CPU op-mode(s):        32-bit, 64-bit\r\n  Byte Order:            Little Endian\r\nCPU(s):                  8\r\n  On-line CPU(s) list:   0-7\r\nVendor ID:               GenuineIntel\r\n"]
[3.4, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[3.9, "o", "free -h\r\n"]
[4.0, "o", "               total        used        free      shared  buff/cache   available\r\nMem:            15Gi       4.2Gi       512Mi       210Mi       9.8Gi        10Gi\r\nSwap:          2.0Gi          0B       2.0Gi\r\n"]
[5.2, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[5.7, "o", "# 'used' is high because of cache — read the 'available' column: 10Gi is free\r\n"]
[6.6, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[7.0, "o", "nproc\r\n"]
[7.1, "o", "8\r\n"]
[7.8, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[8.3, "o", "grep ctxt /proc/stat\r\n"]
[8.4, "o", "ctxt 184062291\r\n"]
[9.0, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[9.5, "o", "# that's the scheduler switching processes — millions of times since boot\r\n"]
[10.6, "o", "\u001b[1;32mlearner@box\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
[11.5, "o", "\r\n"]
